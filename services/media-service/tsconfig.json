{
  "compilerOptions": {
    "target": "es2016",                                                                
    "esModuleInterop": true,                             
    "forceConsistentCasingInFileNames": true,            
    "strict": true,                                   
    "skipLibCheck": true,
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "verbatimModuleSyntax": false,
    "ignoreDeprecations": "5.0",
                                  
  }
}
